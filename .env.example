# Copy this file to .env and fill in real values before running the app.
# NEVER commit the real .env file.

# SQLite by default — zero external services needed.
# To use PostgreSQL instead: DATABASE_URL="postgresql://user:pass@host:5432/dbname"
DATABASE_URL="file:./dev.db"

# Long random string used to sign session/CSRF secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-this-to-a-long-random-string"

# Set to "production" when deployed behind HTTPS — enables Secure cookies and HSTS.
NODE_ENV="development"

# Overrides the seeded default admin password (only used on first run,
# when the users table is empty). If unset, defaults to ChangeMe123!
# and the account is forced to change it on first login regardless.
INITIAL_ADMIN_PASSWORD="ChangeMe123!"

# Base URL of the deployed site, used for sitemap.xml / canonical / OG tags.
SITE_URL="http://localhost:3000"

# Optional: real email delivery for "Forgot password". If unset, reset
# links are printed to the server console/audit log instead of emailed.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Riwayat Jewels <no-reply@riwayatjewels.com>"
