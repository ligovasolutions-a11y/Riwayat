    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.13.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "^16.2.10",
