# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment secrets — never commit real credentials
.env
.env.local
.env.*.local

# Database (SQLite file + Prisma migration engine files)
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal

# Uploaded media (user content, not source)
public/uploads/*
!public/uploads/.gitkeep

# Logs
npm-debug.log*
*.log

# OS/editor cruft
.DS_Store

# TypeScript incremental build cache
tsconfig.tsbuildinfo
